includes:
    - vendor/larastan/larastan/extension.neon

parameters:

    paths:
        - app/
        - database/
        - routes/

    level: 8

    ignoreErrors:
        # Trait oferecido aos modulos (RF15). Ainda nao ha modulo que o use; os testes o exercitam.
        -
            identifier: trait.unused
            path: app/Filament/Tenant/Concerns/RequiresFeature.php
